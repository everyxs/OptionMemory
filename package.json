{
  "name": "optionmemory",
  "version": "0.1.0",
  "private": true,
  "description": "OptionMemory five-layer memory over mnestic with DSH and OpenCode adapters",
  "type": "commonjs",
  "packageManager": "pnpm@11.7.0",
  "main": "dist/plugins/dsh/index.js",
  "exports": {
    ".": "./dist/plugins/dsh/index.js",
    "./opencode": "./dist/plugins/opencode/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "manifest": "dsh.plugin.json",
      "patch": "cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "zod": "4.1.8"
  }
}
