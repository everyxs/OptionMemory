{
  "name": "optionmemory",
  "version": "0.2.0",
  "private": true,
  "description": "OptionMemory five-layer memory over mnestic with DSH and OpenCode adapters",
  "type": "commonjs",
  "packageManager": "pnpm@11.7.0",
  "main": "dist/plugins/dsh/index.js",
  "exports": {
    ".": "./dist/plugins/dsh/index.js",
    "./opencode": "./dist/plugins/opencode/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "manifest": "dsh.plugin.json",
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "zod": "4.1.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  }
}
